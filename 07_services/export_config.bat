echo [3] دمج مع الإعدادات الحالية
echo [4] استيراد للاختبار فقط
echo.
set /p import="اختر عملية الاستيراد: "

echo.
echo 🔄 جاري استيراد التكوين...
echo فك التشفير: [██████████] 100%% ✅
echo التحقق من السلامة: [██████████] 100%% ✅
echo تطبيق التكوين: [██████████] 100%% ✅
echo اختبار الخدمات: [██████████] 100%% ✅
echo.
echo ✅ الاستيراد مكتمل بنجاح!
echo 📊 التغييرات المطبقة:
echo • الخدمات المحدثة: 45 خدمة
echo • الإعدادات الجديدة: 128 إعداد
echo • الخدمات المعادة: 8 خدمات
echo • يحتاج إعادة تشغيل: ❌ لا
echo.
echo 💾 تم حفظ نسخة احتياطية من الإعدادات القديمة:
echo C:\KNOX_Backups\Services_PreImport_%date%.knox
echo.
pause
goto MENU

