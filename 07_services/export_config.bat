echo 1. Services_Backup_2024-01-01.knox (2.4 ميجابايت)
echo    • التاريخ: 2024-01-01
echo    • الخدمات: 256
echo    • الوصف: نسخة احتياطية كاملة
echo.
echo 2. Services_Optimized_2024-01-15.knox (1.8 ميجابايت)
echo    • التاريخ: 2024-01-15
echo    • الخدمات: 242
echo    • الوصف: تكوين محسن للأداء
echo.
