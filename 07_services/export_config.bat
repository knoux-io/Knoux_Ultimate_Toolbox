echo [6] العودة لقائمة الخدمات
echo [7] القائمة الرئيسية
echo.
set /p choice="اختر (1-7): "

if "%choice%"=="1" goto EXPORT_CONFIGURATION
if "%choice%"=="2" goto IMPORT_CONFIGURATION
