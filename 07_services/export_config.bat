echo    • الخدمات: 248
echo    • الوصف: تكوين أمني مشدد
echo.
echo 4. استيراد ملف مخصص...
echo.
set /p file="اختر الملف للاستيراد (1-4): "

if "%file%"=="4" (
    echo.
    echo 📁 أدخل مسار الملف:
    set /p customfile="المسار الكامل: "
