:MERGE_CONFIGURATIONS
cls
echo 🔀 دمج التكوينات
echo ═══════════════════════════════════════════════════════
echo دمج أفضل الإعدادات من تكوينين مختلفين
echo.
echo 📋 خيارات الدمج:
echo [1] دمج تكوين الأداء مع الأمان
echo [2] دمج التكوين الحالي مع الافتراضي
echo [3] دمج مخصص (اختر الملفات)
echo [4] دمج ذكي (بناءً على التحليل)
echo.
set /p merge="اختر خيار الدمج: "

echo.
if "%merge%"=="4" (
    echo 🧠 الدمج الذكي
    echo النظام سيقوم بـ:
    echo 1. تحليل كلا التكوينين
    echo 2. اختيار أفضل الإعدادات من كل منهما
