:MENU
echo [1] تكوين خيارات الاستعادة
echo [2] تحسين خيارات الاستعادة
echo [3] عرض إعدادات الاستعادة الحالية
echo [4] استعادة الإعدادات الافتراضية
echo [5] اختبار استعادة الخدمات
echo [6] العودة لقائمة الخدمات
echo [7] القائمة الرئيسية
echo.
set /p choice="اختر (1-7): "

if "%choice%"=="1" goto CONFIGURE_RECOVERY
if "%choice%"=="2" goto OPTIMIZE_RECOVERY
if "%choice%"=="3" goto VIEW_CURRENT_SETTINGS
if "%choice%"=="4" goto RESTORE_DEFAULTS
if "%choice%"=="5" goto TEST_RECOVERY
if "%choice%"=="6" call "07_services.bat"
if "%choice%"=="7" call "KNOX_MAIN_MENU.BAT"
goto MENU

:CONFIGURE_RECOVERY
cls
echo ⚙️  تكوين خيارات الاستعادة
echo ═══════════════════════════════════════════════════════
echo تكوين ماذا يحدث عند فشل الخدمة
echo.
set /p service="أدخل اسم الخدمة: "

echo.
echo 🔍 جاري تحميل إعدادات '%service%'...
echo تحميل الخدمة: [██████████] 100%%
echo تحميل الإعدادات الحالية: [██████████] 100%%
echo.
echo 📊 الإعدادات الحالية لـ %service%:
echo • إعادة التشغيل عند الفشل: لا
echo • إعادة التشغيل الأول بعد: 1 دقيقة
echo • إعادة التشغيل الثاني بعد: 2 دقيقة
echo • إعادة التشغيل الثالث بعد: 3 دقائق
echo • إعادة تعيين الفشل بعد: 10 دقائق
echo • تشغيل برنامج عند الفشل: لا
echo • إعادة تعيين الفشل: لا
echo.
echo 🎯 خيارات التكوين:
echo [1] إعادة التشغيل التلقائي
echo [2] تشغيل برنامج عند الفشل
echo [3] إعادة تعيين الفشل
echo [4] تكوين متقدم
echo [5] تطبيق إعدادات سريعة
echo.
set /p option="اختر الخيار: "

if "%option%"=="1" (
    echo 🔄 إعادة التشغيل التلقائي
    echo.
    echo ⚙️  إعدادات إعادة التشغيل:
    set /p restart1="إعادة التشغيل الأول بعد (دقائق): "
    set /p restart2="إعادة التشغيل الثاني بعد (دقائق): "
    set /p restart3="إعادة التشغيل الثالث بعد (دقائق): "
    set /p reset="إعادة تعيين الفشل بعد (دقائق): "
    echo.
    echo 🔧 جاري تطبيق إعدادات إعادة التشغيل...
    echo إعادة التشغيل الأول: [██████████] 100%% ✅
    echo إعادة التشغيل الثاني: [██████████] 100%% ✅
    echo إعادة التشغيل الثالث: [██████████] 100%% ✅
    echo إعادة تعيين الفشل: [██████████] 100%% ✅
    echo.
    echo ✅ تم تكوين إعادة التشغيل التلقائي!
    echo 📊 الإعدادات الجديدة:
    echo • إعادة التشغيل الأول: بعد %restart1% دقيقة
    echo • إعادة التشغيل الثاني: بعد %restart2% دقائق
    echo • إعادة التشغيل الثالث: بعد %restart3% دقائق
    echo • إعادة تعيين الفشل: بعد %reset% دقائق
)
if "%option%"=="2" (
    echo 🚀 تشغيل برنامج عند الفشل
    echo.
    echo 📂 اختر البرنامج الذي سيتم تشغيله:
    echo [1] لا شيء
    echo [2] برنامج مخصص
    echo [3] سكربت PowerShell
    echo [4] أداة تشخيص
    echo.
    set /p program="اختر البرنامج: "

    if "%program%"=="2" (
        echo 📁 أدخل مسار البرنامج:
        set /p path="المسار الكامل: "
        echo.
        echo 🔧 جاري تكوين تشغيل البرنامج...
        echo تحديد البرنامج: [██████████] 100%% ✅
        echo التحقق من المسار: [██████████] 100%% ✅
        echo تطبيق الإعدادات: [██████████] 100%% ✅
        echo.
        echo ✅ تم تكوين تشغيل البرنامج!
        echo 📊 البرنامج: %path%
    )
)
pause
goto MENU

:OPTIMIZE_RECOVERY
cls
echo ⚡ تحسين خيارات الاستعادة
echo ═══════════════════════════════════════════════════════
echo تحسين تلقائي لخيارات استعادة الخدمات
echo.
