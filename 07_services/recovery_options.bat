    echo 2. RPC Service: 1.5 ثانية
    echo 3. Event Log: 1.8 ثانية
    echo.
    echo ⚠️  يحتاج تحسين:
    echo 1. Windows Update: 4.5 ثانية
    echo 2. Windows Defender: 4.2 ثانية
)
echo.
