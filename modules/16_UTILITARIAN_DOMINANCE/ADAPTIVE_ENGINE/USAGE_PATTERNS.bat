set /p choice="اختر تحليل الأنماط [0-10, A, S, H]: "

if "%choice%"=="1" goto TIME_PATTERNS_ANALYSIS
if "%choice%"=="2" goto TOOL_PATTERNS_ANALYSIS
if "%choice%"=="3" goto TASK_PATTERNS_ANALYSIS
if "%choice%"=="4" goto CUSTOMIZATION_PATTERNS_ANALYSIS
if "%choice%"=="5" goto PERFORMANCE_PATTERNS_ANALYSIS
if "%choice%"=="6" goto PREDICT_NEXT_ACTION
if "%choice%"=="7" goto SMART_SUGGESTIONS
if "%choice%"=="8" goto LEARN_NEW_PATTERNS
if "%choice%"=="9" goto SAVE_DETECTED_PATTERNS
if "%choice%"=="10" goto ANALYZE_PATTERN_EFFECTIVENESS

if /i "%choice%"=="A" goto ADVANCED_PATTERN_SETTINGS
if /i "%choice%"=="S" goto PATTERN_STATISTICS
if /i "%choice%"=="H" goto PATTERN_HISTORY
