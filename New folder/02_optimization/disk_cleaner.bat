echo ═══════════════════════════════════════════════════════
timeout /t 3 /nobreak >nul
echo 📊 تحليل محتويات السلة: [██████████] 100%%
timeout /t 2 /nobreak >nul
echo 🗑️  حذف الملفات المؤقتة: [██████████] 100%%
