    echo • الأداء: +20%%
    echo • الاستقرار: +15%%
    echo • استهلاك الطاقة: -10%%
    echo • الاستجابة: +25%%
)
if "%option%"=="2" (
    echo • الأولوية: للألعاب
    echo • الأداء: +35%%
    echo • الاستقرار: +10%%
    echo • استهلاك الطاقة: +15%%
