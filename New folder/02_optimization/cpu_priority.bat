echo ⚙️  خيارات التحسين:
echo [1] تحسين تلقائي (موصى به)
echo [2] تحسين للألعاب
echo [3] تحسين للأعمال
echo [4] تحسين مخصص
echo.
set /p option="اختر التحسين: "

echo.
echo ⚡ جاري تحسين أولوية المعالج...
echo ═══════════════════════════════════════════════════════
timeout /t 3 /nobreak >nul
echo 📊 تحليل الأولويات الحالية: [██████████] 100%%
