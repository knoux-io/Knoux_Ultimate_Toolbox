setlocal
set "SCRIPT_DIR=%~dp0"

:MENU
echo [1] تحسين أولوية المعالج
echo [2] تحليل أولوية المعالج
echo [3] إدارة أولوية العمليات
echo [4] وضع الأداء القصوى
echo [5] وضع متوازن
echo [6] استعادة الإعدادات
echo [7] العودة لقائمة التحسين
echo [8] القائمة الرئيسية
echo.
set /p choice="اختر (1-8): "

if "%choice%"=="1" goto OPTIMIZE_PRIORITY
if "%choice%"=="2" goto ANALYZE_PRIORITY
if "%choice%"=="3" goto MANAGE_PRIORITY
if "%choice%"=="4" goto MAX_PERFORMANCE
if "%choice%"=="5" goto BALANCED_MODE
if "%choice%"=="6" goto RESTORE_DEFAULTS
if "%choice%"=="7" call "%SCRIPT_DIR%02_optimization.bat"
if "%choice%"=="8" call "%SCRIPT_DIR%..\KNOX_MAIN_MENU.BAT"
goto MENU

:OPTIMIZE_PRIORITY
cls
echo ⚡ تحسين أولوية المعالج
echo ═══════════════════════════════════════════════════════
echo تحسين أولوية المعالج لتحسين أداء النظام
