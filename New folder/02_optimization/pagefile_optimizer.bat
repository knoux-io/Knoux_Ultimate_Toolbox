setlocal
set "SCRIPT_DIR=%~dp0"

:MENU
echo [1] تحسين ملف الصفحة
echo [2] تحليل ملف الصفحة
echo [3] إدارة ملف الصفحة
echo [4] إعدادات ملف الصفحة
echo [5] استعادة الإعدادات
echo [6] العودة لقائمة التحسين
echo [7] القائمة الرئيسية
echo.
set /p choice="اختر (1-7): "

if "%choice%"=="1" goto OPTIMIZE_PAGEFILE
if "%choice%"=="2" goto ANALYZE_PAGEFILE
if "%choice%"=="3" goto MANAGE_PAGEFILE
if "%choice%"=="4" goto PAGEFILE_SETTINGS
if "%choice%"=="5" goto RESTORE_DEFAULTS
if "%choice%"=="6" call "%SCRIPT_DIR%02_optimization.bat"
if "%choice%"=="7" call "%SCRIPT_DIR%..\KNOX_MAIN_MENU.BAT"
goto MENU

:OPTIMIZE_PAGEFILE
cls
echo ⚡ تحسين ملف الصفحة
echo ═══════════════════════════════════════════════════════
echo تحسين ملف الصفحة لتحسين أداء النظام
echo.
echo 📊 حالة ملف الصفحة الحالية:
echo • الحجم: 8 جيجابايت
echo • الموقع: C:\pagefile.sys
echo • الإدارة: تلقائي
echo • الحالة: سليم
echo • الاستخدام: 45%%
echo.
echo ⚙️  خيارات التحسين:
echo [1] تحسين تلقائي (موصى به)
echo [2] تحسين للأداء
echo [3] تحسين للمساحة
echo [4] تحسين مخصص
echo.
set /p option="اختر التحسين: "

echo.
echo ⚡ جاري تحسين ملف الصفحة...
echo ═══════════════════════════════════════════════════════
timeout /t 3 /nobreak >nul
echo 📊 تحليل ملف الصفحة: [██████████] 100%%
timeout /t 2 /nobreak >nul
echo ⚡ تطبيق التحسينات: [██████████] 100%%
timeout /t 2 /nobreak >nul
echo 📝 تحديث الإعدادات: [██████████] 100%%
timeout /t 2 /nobreak >nul
echo ✅ التحقق من التغييرات: [██████████] 100%%
