    echo • الحجم الجديد: 4 جيجابايت
    echo • الإدارة: محسنة
    echo • الأداء: +25%%
    echo • المساحة: +4 جيجابايت
    echo • الاستقرار: محسن
)
if "%option%"=="2" (
    echo • الحجم الجديد: 12 جيجابايت
    echo • الأداء: +35%%
    echo • الاستخدام: +20%%
    echo • الاستقرار: محسن
    echo • الأداء: ممتاز
