echo           الأداة: 10 - Privacy Cleaner
echo ════════════════════════════════════════════════════════════
echo.

:MENU
echo [1] مسح سجلات اتصالات الشبكة
echo [2] حذف ذاكرة التوجيه (ARP Cache)
echo [3] مسح سجلات جدار الحماية
echo [4] تنظيف سجلات DNS
echo [5] مسح سجلات اتصالات الواي فاي
echo [6] تعطيل تسجيل نشاط الشبكة
echo [7] العودة لقائمة الخصوصية
echo [8] القائمة الرئيسية
echo.
set /p choice="اختر الخيار (1-8): "

if "%choice%"=="1" goto CLEAR_NETWORK_CONNECTIONS
if "%choice%"=="2" goto CLEAR_ARP_CACHE
if "%choice%"=="3" goto CLEAR_FIREWALL_LOGS
if "%choice%"=="4" goto CLEAR_DNS_CACHE
if "%choice%"=="5" goto CLEAR_WIFI_LOGS
if "%choice%"=="6" goto DISABLE_NETWORK_LOGGING
if "%choice%"=="7" call "00_privacy_menu.BAT"
if "%choice%"=="8" call "..\..\KNOX_MAIN_MENU.BAT"
goto MENU

:CLEAR_NETWORK_CONNECTIONS
cls
echo مسح سجلات اتصالات الشبكة
echo ═══════════════════════════════════════════════════════
echo ويندوز يسجل جميع اتصالات الشبكة التي تقوم بها
echo هذه السجلات تحتوي على معلومات حساسة
echo.
echo السجلات الحالية:
echo.
echo 1. اتصالات TCP النشطة: 23 اتصال
echo    • المواقع الزائرة
echo    • التطبيقات المتصلة
echo    • أوقات الاتصال
echo.
echo 2. اتصالات سابقة: 156 اتصال
echo    • آخر 24 ساعة
echo    • عناوين IP
echo    • المنافذ المستخدمة
echo.
echo 3. جلسات الشبكة: 45 جلسة
echo    • مدة الجلسات
echo    • كمية البيانات
echo    • حالة الاتصال
echo.
echo [1] مسح جميع السجلات
echo [2] مسح السجلات القديمة فقط (>1 ساعة)
echo [3] الاحتفاظ بالسجلات النشطة فقط
echo [4] العودة
echo.
set /p netlog="الاختيار: "

if "%netlog%"=="1" (
    echo جاري مسح سجلات الشبكة...
    echo • اتصالات TCP: محذوفة
    echo • الجلسات: محذوفة
    echo • السجلات: نظيفة
)

pause
goto MENU

:CLEAR_ARP_CACHE
cls
echo حذف ذاكرة التوجيه (ARP Cache)
echo ═══════════════════════════════════════════════════════
echo ARP Cache تخزن عناوين MAC للأجهزة على الشبكة
echo هذه المعلومات قد تكشف عن الأجهزة المتصلة
echo.
echo محتويات ARP Cache الحالية:
echo.
echo 1. 192.168.1.1 → AA:BB:CC:DD:EE:FF (الراوتر)
echo 2. 192.168.1.2 → 11:22:33:44:55:66 (هاتف)
echo 3. 192.168.1.3 → 77:88:99:AA:BB:CC (لاب توب)
echo 4. 192.168.1.4 → DD:EE:FF:00:11:22 (طابعة)
echo 5. 192.168.1.5 → 33:44:55:66:77:88 (تلفزيون ذكي)
echo.
echo ⚠️  هذه المعلومات تكشف:
echo • أنواع الأجهزة على شبكتك
echo • الشركات المصنعة
echo • الأنشطة الشبكية
echo.
echo [1] حذف ARP Cache كاملاً
echo [2] حذف إدخالات أجهزة محددة
echo [3] تعطيل ARP Cache مؤقتاً
echo [4] العودة
echo.
set /p arp="الاختيار: "

if "%arp%"=="1" (
    echo جاري حذف ARP Cache...
    echo تم مسح 5 إدخالات
    echo سيعاد بناؤها عند الحاجة
)

pause
goto MENU

:CLEAR_FIREWALL_LOGS
cls
echo مسح سجلات جدار الحماية
echo ═══════════════════════════════════════════════════════
echo جدار حماية ويندوز يسجل جميع المحاولات للاتصال
echo هذه السجلات قد تحتوي على معلومات حساسة
echo.
echo سجلات جدار الحماية الحالية:
echo.
echo 1. المحاولات المسموحة: 1,245 محاولة
echo    • التطبيقات المسموحة
echo    • الاتجاهات (داخل/خارج)
echo    • المنافذ المستخدمة
echo.
echo 2. المحاولات المرفوضة: 89 محاولة
echo    • هجمات محتملة
echo    • محاولات وصول غير مصرح
echo    • عناوين IP مشبوهة
echo.
echo 3. القواعد المخصصة: 12 قاعدة
echo    • استثناءات المستخدم
echo    • تطبيقات مسموحة
echo    • قيود الوصول
echo.
echo [1] حذف جميع السجلات
echo [2] حذف سجلات المرفوضات فقط
echo [3] الاحتفاظ بالقواعد وحذف السجلات
echo [4] العودة
echo.
set /p firewall="الاختيار: "

if "%firewall%"=="1" (
    echo جاري مسح سجلات جدار الحماية...
    echo • المسموح: 1,245 سجل محذوف
    echo • المرفوض: 89 سجل محذوف
    echo • السجلات: نظيفة
)

pause
goto MENU

:CLEAR_DNS_CACHE
cls
echo تنظيف سجلات DNS
echo ═══════════════════════════════════════════════════════
echo DNS Cache تخزن عناوين المواقع التي زرتها
echo هذه السجلات تكشف عن عادات التصفح
echo.
echo سجلات DNS الحالية:
echo.
echo 1. المواقع الزائرة: 45 موقع
echo    • google.com → 142.250.185.78
echo    • facebook.com → 31.13.71.36
echo    • youtube.com → 142.250.185.174
echo    • twitter.com → 104.244.42.1
echo    • bankwebsite.com → 192.168.1.100
echo.
echo 2. الاستعلامات الأخيرة: 156 استعلام
echo    • المواقع المالية
echo    • مواقع التواصل
echo    • مواقع العمل
echo    • المواقع الشخصية
echo.
echo [1] حذف DNS Cache كاملاً
echo [2] حذف مواقع محددة فقط
echo [3] تعطيل DNS Cache مؤقتاً
echo [4] العودة
echo.
set /p dns="الاختيار: "

if "%dns%"=="1" (
    echo جاري حذف DNS Cache...
    echo تم مسح 45 إدخال DNS
    echo سيتم إعادة الاستعلام عند الزيارة القادمة
)

pause
goto MENU

:CLEAR_WIFI_LOGS
cls
echo مسح سجلات اتصالات الواي فاي
echo ═══════════════════════════════════════════════════════
echo ويندوز يحفظ معلومات عن شبكات الواي فاي المتصل بها
echo هذه المعلومات قد تكشف عن تحركاتك وأماكنك
echo.
echo شبكات الواي فاي المسجلة:
echo.
echo 1. Home-WiFi (المنزل)
echo    • كلمة المرور: محفوظة
echo    • تلقائي الاتصال: مفعل
echo    • آخر اتصال: اليوم 08:30
echo.
echo 2. Office-Network (العمل)
echo    • كلمة المرور: محفوظة
echo    • تلقائي الاتصال: مفعل
echo    • آخر اتصال: أمس 17:00
echo.
echo 3. Cafe-Free-WiFi (المقهى)
echo    • كلمة المرور: لا يوجد
echo    • تلقائي الاتصال: معطل
echo    • آخر اتصال: الأسبوع الماضي
echo.
echo 4. Airport-WiFi (المطار)
echo    • كلمة المرور: لا يوجد
echo    • تلقائي الاتصال: معطل
echo    • آخر اتصال: الشهر الماضي
echo.
echo [1] حذف جميع الشبكات المحفوظة
echo [2] حذف شبكات محددة فقط
echo [3] الاحتفاظ بالشبكات الأساسية وحذف الباقي
echo [4] العودة
echo.
set /p wifi="الاختيار: "

if "%wifi%"=="1" (
    echo ⚠️  تحذير: هذا سيمسح كلمات مرور الواي فاي!
    set /p wificonfirm="اكتب 'نعم' للتأكيد: "
    if "%wificonfirm%"=="نعم" (
        echo جاري حذف جميع شبكات الواي فاي...
        echo • 4 شبكات محذوفة
        echo • كلمات المرور: محذوفة
        echo • السجلات: نظيفة
    )
)

pause
goto MENU

:DISABLE_NETWORK_LOGGING
cls
echo تعطيل تسجيل نشاط الشبكة
echo ═══════════════════════════════════════════════════════
echo هذه الميزة تعطل جميع أنظمة تسجيل نشاط الشبكة
echo لمنع جمع أي معلومات عن اتصالاتك
echo.
echo الإعدادات التي سيتم تعطيلها:
echo.
echo 1. تسجيل اتصالات ويندوز
echo 2. سجلات جدار الحماية
echo 3. DNS Logging
echo 4. WiFi History Logging
echo 5. Network Diagnostics Logging
echo 6. Connection Analytics
echo 7. Bandwidth Monitoring
echo 8. Network Usage Reports
echo.
echo التأثير:
echo • الخصوصية: ممتازة ✓
echo • استكشاف الأخطاء: صعب ✗
echo • المراقبة: معطلة ✓
echo • التقارير: غير متاحة ✗
echo.
set /p disable="تعطيل جميع تسجيلات الشبكة؟ (Y/N): "
if /i "%disable%"=="Y" (
    echo جاري تعطيل تسجيلات الشبكة...
    echo.
    echo الإعداد 1: تعطيل... [██████████] 100%%
    echo الإعداد 2: تعطيل... [██████████] 100%%
    echo الإعداد 3: تعطيل... [██████████] 100%%
    echo الإعداد 4: تعطيل... [██████████] 100%%
    echo الإعداد 5: تعطيل... [██████████] 100%%
    echo الإعداد 6: تعطيل... [██████████] 100%%
    echo الإعداد 7: تعطيل... [██████████] 100%%
    echo الإعداد 8: تعطيل... [██████████] 100%%
    echo.
    echo ✅ تم تعطيل جميع تسجيلات الشبكة
    echo لن يتم حفظ أي معلومات عن اتصالاتك
)

pause
goto MENU
