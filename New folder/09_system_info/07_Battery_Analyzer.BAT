timeout /t 45 /nobreak >nul
echo ✅ تم الشحن إلى 100%%
echo.
echo ⏱️  المرحلة 2/5: الانتظار ساعتين
echo ترك البطارية مشحونة بالكامل
echo تثبيت الشحن عند 100%%
