timeout /t 120 /nobreak >nul
echo ✅ اكتمل الانتظار
echo.
echo 📉 المرحلة 3/5: التفريغ إلى 3%%
echo فصل الشاحن...
echo استخدام النظام حتى 3%%
echo ⚠️  لا تعيد الشحن أثناء هذه المرحلة
echo ⏱️  الوقت المتوقع: 4-5 ساعات...
echo ... جاري التفريغ ...
echo ✅ وصلت إلى 3%%
echo.
echo 🔋 المرحلة 4/5: التفريغ الكامل
echo ترك النظام حتى الإغلاق التلقائي
echo ⏱️  الانتظار 15 دقيقة...
timeout /t 15 /nobreak >nul
echo ✅ تم التفريغ الكامل
echo.
echo 📈 المرحلة 5/5: الشحن الكامل
echo توصيل الشاحن...
echo الشحن إلى 100%% بدون مقاطعة
echo ⏱️  الوقت المتوقع: 1.5 ساعة...
timeout /t 90 /nobreak >nul
echo ✅ اكتمل الشحن
echo.
echo 🎉 معايرة البطارية مكتملة!
echo 📊 نتائج المعايرة:
echo • دقة قراءة الشحن: 99.8%% (كانت 94.5%%)
