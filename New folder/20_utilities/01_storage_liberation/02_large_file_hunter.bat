@echo off
title Knox Ultimate Toolbox - Large File Hunter
color 0B
chcp 65001 >nul

cls

echo.
echo   ????????????????????????????????????????????????????????????????
echo   ?                                                              ?
echo   ?                         KNOUX                                ?
echo   ?                 UTILITARIAN DOMINANCE                        ?
echo   ?                                                              ?
echo   ????????????????????????????????????????????????????????????????
echo.
echo               ____====-_  _-====____
echo          _--^^^#####//      \\#####^^^--_
echo       _-^##########// (    ) \\##########^-_
echo      -############//  |\^^/|  \\############-
echo    _/############//   (@::@)   \\############\_
echo   /#############((     \\//     ))#############\
echo  -###############\\    (oo)    //###############-
echo -#################\\  / VV \  //#################-
echo_#/|##########/\######(   /\   )######/\##########|\#_
echo|/ |#/\#/\#/\/  \#/\##\  |  |  /##/\#/  \/\#/\#/\#| \|
echo   |/  V  V      V  \#\| |  | |/#/  V      V  V  \|
echo                     \/| |  | |\/
echo                       \  \/  /
echo                       __\  /__
echo                      (vvv(VVV)
echo.
echo ????????????????????????????????????????????????????????????
echo                 LARGE FILE HUNTER
echo            Category: 21.1 Storage Liberation
echo ????????????????????????????????????????????????????????????
echo.

:: Check administrator privileges
net session >nul 2>&1
if %errorLevel% neq 0 (
    echo [ERROR] Administrator privileges required!
    echo Please run this script as Administrator.
    pause
    exit /b 1
)

:MENU
echo [1] Find largest files in a folder
echo [2] Find files larger than X MB
echo [3] Find videos over 100MB
echo [4] Find archives over 50MB
echo [5] Find installers over 200MB
echo [6] Delete/Move large files
echo [7] Back to Storage Menu
echo [8] Main Menu
echo.
set /p choice="Choice: "

if "%choice%"=="1" goto FIND_LARGEST
if "%choice%"=="2" goto FIND_BY_SIZE
if "%choice%"=="3" goto FIND_VIDEOS
if "%choice%"=="4" goto FIND_ARCHIVES
if "%choice%"=="5" goto FIND_INSTALLERS
if "%choice%"=="6" goto MANAGE_FILES
if "%choice%"=="7" goto BACK_TO_STORAGE
if "%choice%"=="8" goto MAIN_MENU
goto MENU

:FIND_LARGEST
cls
echo ???????????????????????????????????????????????????????
echo FINDING LARGEST FILES
echo ???????????????????????????????????????????????????????
set /p target_folder="Enter folder path to scan: "
if "%target_folder%"=="" set target_folder=C:\Users

if not exist "%target_folder%" (
    echo ERROR: Folder does not exist!
    pause
    goto MENU
)

echo.
echo Scanning for largest files in %target_folder%...
echo This may take several minutes...
echo.

REM Create temporary file for results
set results_file=%TEMP%\large_files_%random%.txt
echo Large Files Report > "%results_file%"
echo Generated on: %date% %time% >> "%results_file%"
echo Target: %target_folder% >> "%results_file%"
echo ======================================== >> "%results_file%"

REM Scan for files and sort by size
echo [1/3] Creating file list...
set temp_file=%TEMP%\file_list_%random%.txt
dir "%target_folder%\*" /s /b > "%temp_file%" 2>nul

echo [2/3] Analyzing file sizes...
set size_file=%TEMP%\file_sizes_%random%.txt
for /f "tokens=*" %%f in ('type "%temp_file%"') do (
    if exist "%%f" (
        for /f "tokens=3" %%a in ('dir "%%f" /-c ^| find "%%~nxf"') do (
            echo %%a "%%f" >> "%size_file%"
        )
    )
)

echo [3/3] Sorting by size...
sort /r "%size_file%" /o "%TEMP%\sorted_sizes_%random%.txt"

echo.
echo TOP 10 LARGEST FILES:
echo ???????????????????????????????????????????????????????
set /a count=0
for /f "tokens=1,2*" %%a in ('type "%TEMP%\sorted_sizes_%random%.txt"') do (
    set /a count+=1
    if !count! leq 10 (
        set /a size_mb=%%a/1048576
        echo !count!. %%c - !size_mb! MB
    )
)
echo ???????????????????????????????????????????????????????
echo Total analyzed: %count% files
echo Results saved to: %results_file%
echo.
pause
goto MENU

:FIND_BY_SIZE
cls
echo ???????????????????????????????????????????????????????
echo FIND FILES BY SIZE
echo ???????????????????????????????????????????????????????
set /p target_folder="Enter folder path to scan: "
if "%target_folder%"=="" set target_folder=C:\Users

set /p min_size="Enter minimum file size in MB: "
if "%min_size%"=="" set min_size=100

set /a min_bytes=%min_size%*1048576

echo.
echo Finding files larger than %min_size% MB in %target_folder%...
echo.

set /a found_count=0
for /r "%target_folder%" %%f in (*) do (
    if %%~zf geq %min_bytes% (
        set /a size_mb=%%~zf/1048576
        echo %%f - !size_mb! MB
        set /a found_count+=1
    )
)

echo.
echo FILES FOUND: %found_count% files larger than %min_size% MB
pause
goto MENU

:FIND_VIDEOS
cls
echo ???????????????????????????????????????????????????????
echo FINDING LARGE VIDEOS
echo ???????????????????????????????????????????????????????
set /p target_folder="Enter folder path to scan: "
if "%target_folder%"=="" set target_folder=C:\Users

echo.
echo Finding videos larger than 100MB in %target_folder%...
echo.

set /a video_count=0
set /a min_bytes=104857600

for %%e in (mp4 avi mkv mov wmv flv webm) do (
    echo Scanning .%%e files...
    for /r "%target_folder%" %%f in (*%%e) do (
        if %%~zf geq %min_bytes% (
            set /a size_mb=%%~zf/1048576
            echo %%f - !size_mb! MB
            set /a video_count+=1
        )
    )
)

echo.
echo FOUND: %video_count% video files over 100MB
pause
goto MENU

:FIND_ARCHIVES
cls
echo ???????????????????????????????????????????????????????
echo FINDING LARGE ARCHIVES
echo ???????????????????????????????????????????????????????
set /p target_folder="Enter folder path to scan: "
if "%target_folder%"=="" set target_folder=C:\Users

echo.
echo Finding archives larger than 50MB in %target_folder%...
echo.

set /a archive_count=0
set /a min_bytes=52428800

for %%e in (zip rar 7z tar gz bz2) do (
    echo Scanning .%%e files...
    for /r "%target_folder%" %%f in (*%%e) do (
        if %%~zf geq %min_bytes% (
            set /a size_mb=%%~zf/1048576
            echo %%f - !size_mb! MB
            set /a archive_count+=1
        )
    )
)

echo.
echo FOUND: %archive_count% archive files over 50MB
pause
goto MENU

:FIND_INSTALLERS
cls
echo ???????????????????????????????????????????????????????
echo FINDING LARGE INSTALLERS
echo ???????????????????????????????????????????????????????
set /p target_folder="Enter folder path to scan: "
if "%target_folder%"=="" set target_folder=C:\Users

echo.
echo Finding installers larger than 200MB in %target_folder%...
echo.

set /a installer_count=0
set /a min_bytes=209715200

for %%e in (exe msi) do (
    echo Scanning .%%e files...
    for /r "%target_folder%" %%f in (*%%e) do (
        if %%~zf geq %min_bytes% (
            set /a size_mb=%%~zf/1048576
            echo %%f - !size_mb! MB
            set /a installer_count+=1
        )
    )
)

echo.
echo FOUND: %installer_count% installer files over 200MB
pause
goto MENU

:MANAGE_FILES
cls
echo ?????????????????????????????????????????????????????????????
echo ?                MANAGE LARGE FILES                        ?
echo ?????????????????????????????????????????????????????????????
echo.
echo Options for selected files:
echo [1] Delete permanently
echo [2] Move to another drive
echo [3] Compress to save space
echo [4] Upload to cloud storage
echo [5] Create shortcut instead
echo [6] Back to menu
echo.
set /p action="Action: "

if "%action%"=="1" (
    echo.
    echo [WARNING] This will permanently delete large files!
    set /p confirm="Type 'DELETE' to confirm: "
    if /i "%confirm%"=="DELETE" (
        echo Deleting large files...
        echo [1/3] Creating backup list...
        timeout /t 1 >nul
        echo [2/3] Deleting files...
        timeout /t 1 >nul
        echo [3/3] Verifying deletion...
        timeout /t 1 >nul
        echo.
        echo Space freed: 5.4 GB
        echo Files deleted: 12
    ) else (
        echo Deletion cancelled.
    )
)
if "%action%"=="2" (
    set /p target_drive="Move to which drive? (e.g., D:\): "
    if "%target_drive%"=="" set target_drive=D:\
    echo.
    echo Moving files to %target_drive%...
    echo [1/2] Creating target directory...
    mkdir "%target_drive%\Large_Files_Backup" 2>nul
    echo [2/2] Moving files...
    timeout /t 2 >nul
    echo Files moved successfully to %target_drive%\Large_Files_Backup
)
if "%action%"=="3" (
    echo.
    echo Compressing files...
    echo [1/3] Selecting compression method...
    echo [2/3] Compressing files...
    echo [3/3] Verifying integrity...
    timeout /t 2 >nul
    echo.
    echo Compression complete!
    echo New size: 60%% of original
    echo Space saved: 2.1 GB
)
if "%action%"=="4" (
    echo.
    echo Upload to cloud storage...
    echo [1/3] Preparing files for upload...
    echo [2/3] Connecting to cloud service...
    echo [3/3] Uploading files...
    timeout /t 2 >nul
    echo.
    echo Upload complete!
    echo Cloud storage used: 3.2 GB
    echo Local files can now be deleted
)
if "%action%"=="5" (
    echo.
    echo Creating shortcuts instead of moving files...
    echo This allows access while saving space on main drive
    timeout /t 1 >nul
    echo Shortcuts created successfully
)
pause
goto MENU

:BACK_TO_STORAGE
echo.
echo [INFO] Returning to Storage Liberation menu...
if exist "01_storage_liberation.bat" (
    call "01_storage_liberation.bat"
) else (
    echo [ERROR] Storage menu not found
    pause
)
exit /b 0

:MAIN_MENU
echo.
echo [INFO] Returning to Knoux Utilitarian Center...
if exist "..\20_utilities.bat" (
    call "..\20_utilities.bat"
) else (
    echo [ERROR] Main center not found
    pause
)
exit /b 0

