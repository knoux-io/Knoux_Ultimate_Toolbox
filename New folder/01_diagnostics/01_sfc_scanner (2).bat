:BACK_TO_SECTION
echo.
echo [INFO] Returning to Diagnostics menu...
if exist "01_diagnostics_menu.bat" (
    call "01_diagnostics_menu.bat"
) else (
    echo [ERROR] Diagnostics menu not found
    pause
)
exit /b 0

