:DEEP_REPAIR
cls
echo ?? Deep Scan with Repair
echo ???????????????????????????????????????????????????????
echo Deep scan and automatic error repair
echo ??  Requires system restart for system drive
echo Estimated time: 15-45 minutes (depending on disk size)
echo.
set /p drive="Enter drive letter (example: C): "

echo.
echo ??  Important warning:
echo ? Scan will be scheduled for next restart
echo ? Drive will be temporarily dismounted during scan
echo ? Boot time may be extended
echo.
set /p confirm="Do you want to schedule deep scan for drive %drive%:? (Y/N): "
if /i not "%confirm%"=="Y" goto MENU

echo.
echo ?? Deep scan scheduled for drive %drive%:
echo ? Will execute on next restart
echo ?? Scheduled operations:
echo 1. Complete disk surface scan
echo 2. Automatic logical error repair
echo 3. File recovery if possible
echo 4. Optimize file table
echo.
echo ?? Tip: Save your work and restart now
pause
goto MENU

