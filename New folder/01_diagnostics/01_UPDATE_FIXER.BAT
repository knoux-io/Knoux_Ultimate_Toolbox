:RESET_SERVICE
cls
echo 🔄 إعادة تعيين خدمة التحديثات
echo ═══════════════════════════════════════════════════════
echo إعادة ضبط وإعادة تسجيل خدمات التحديث
echo.
echo ⚠️  العمليات التي ستتم:
echo • إيقاف جميع خدمات التحديث
echo • حذف الملفات المؤقتة
echo • إعادة تسجيل DLLs
echo • إعادة تشغيل الخدمات
echo • إعادة بناء قاعدة البيانات
echo.
set /p confirm="هل تريد إعادة تعيين خدمات التحديث؟ (نعم/لا): "
if /i not "%confirm%"=="نعم" goto MENU

echo.
echo 🔧 جاري إعادة التعيين...
echo إيقاف خدمات التحديث: [██████████] 100%%
echo حذف الملفات المؤقتة: [██████████] 100%%
echo إعادة تسجيل المكونات: [██████████] 100%%
echo إعادة بناء قاعدة البيانات: [██████████] 100%%
echo تشغيل الخدمات من جديد: [██████████] 100%%
echo.
echo ✅ إعادة التعيين مكتملة!
echo 📊 النتائج:
echo • الخدمات المعاد تعيينها: 5 خدمات
echo • الملفات المحذوفة: 342 ملف
echo • المكونات المسجلة: 28 مكون
echo • المساحة المحررة: 1.2 جيجابايت
