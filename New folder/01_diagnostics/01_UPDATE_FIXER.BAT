echo.
pause
goto MENU

:REPAIR_COMPONENTS
cls
echo 🔧 إصلاح مكونات التحديث
echo ═══════════════════════════════════════════════════════
echo إصلاح المكونات الأساسية لنظام التحديث
echo.
echo 📋 المكونات التي سيتم إصلاحها:
echo • BITS (Background Intelligent Transfer Service)
echo • Windows Update Agent
echo • Cryptographic Services
echo • Windows Installer
echo • Windows Modules Installer
echo.
echo ⚠️  هذه العملية تتطلب اتصال إنترنت
echo.
set /p confirm="هل تريد إصلاح جميع المكونات؟ (نعم/لا): "
if /i not "%confirm%"=="نعم" goto MENU

echo.
echo 🛠️  جاري إصلاح المكونات...
