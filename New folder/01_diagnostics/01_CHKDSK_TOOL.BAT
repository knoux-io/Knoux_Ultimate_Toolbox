echo [7] القائمة الرئيسية
echo.
set /p choice="اختر (1-7): "

if "%choice%"=="1" goto QUICK_CHECK
if "%choice%"=="2" goto DEEP_REPAIR
if "%choice%"=="3" goto BAD_SECTORS
