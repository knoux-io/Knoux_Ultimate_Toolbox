:MENU
echo [1] Diagnose Boot Problems
echo [2] Repair Boot Configuration Data (BCD)
echo [3] Rebuild Boot Files
echo [4] Restore Boot Settings
echo [5] Create Backup
echo [6] Back to Diagnostics Menu
echo [7] Main Menu
echo.
call :get_text "SELECT_OPTION"
echo %RETURN_TEXT% [1-7]:
set /p choice=""

if "%choice%"=="1" goto DIAGNOSE_BOOT
if "%choice%"=="2" goto REPAIR_BCD
if "%choice%"=="3" goto REBUILD_FILES
if "%choice%"=="4" goto RESTORE_SETTINGS
if "%choice%"=="5" goto CREATE_BACKUP
if "%choice%"=="6" call "01_diagnostics_menu.bat"
