:REPAIR_BCD
cls
echo ?? Repair Boot Configuration Data (BCD)
echo ???????????????????????????????????????????????????????
echo Repair and rebuild BCD (Boot Configuration Data)
echo ??  Sensitive operation - requires administrator privileges
echo.
echo ?? What will be repaired:
echo ? Re-create BCD store
echo ? Add boot entries
echo ? Correct boot paths
echo ? Adjust time settings
echo.
set /p confirm="Do you want to repair BCD? (Y/N): "
if /i not "%confirm%"=="Y" goto MENU

echo.
