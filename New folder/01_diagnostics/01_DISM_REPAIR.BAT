echo 🔧 إصلاح صورة النظام
echo ═══════════════════════════════════════════════════════
echo إصلاح تلقائي لصورة Windows التالفة
echo الوقت المتوقع: 10-15 دقيقة
echo.
echo ⚠️  متطلبات:
echo • اتصال بالإنترنت (لتحميل الملفات)
echo • 5 جيجابايت مساحة حرة
echo • صلاحيات مسؤول
echo.
set /p confirm="هل تريد متابعة الإصلاح؟ (نعم/لا): "
if /i not "%confirm%"=="نعم" goto MENU

echo.
echo 🛠️  جاري إصلاح صورة النظام...
echo المرحلة 1/4: التحضير للإصلاح [██████████] 100%%
