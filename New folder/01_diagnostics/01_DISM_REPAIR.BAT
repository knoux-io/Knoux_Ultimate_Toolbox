echo.
echo 🔄 يفضل إعادة التشغيل للتأكد من التطبيق
pause
goto MENU

:CLEAN_COMPONENTS
cls
echo 🧹 تنظيف مكونات النظام
echo ═══════════════════════════════════════════════════════
echo تنظيف وإزالة المكونات غير الضرورية
echo.
echo 📋 المكونات القابلة للتنظيف:
echo • تحديثات Windows القديمة
echo • ملفات تثبيت مؤقتة
echo • سجلات عمليات التثبيت الفاشلة
echo • مكونات معطلة
echo.
echo 💾 المساحة القابلة للتحرير: 4.2 جيجابايت
echo.
set /p clean="ما الذي تريد تنظيفه؟ (1=الكل, 2=اختياري): "

if "%clean%"=="1" (
    echo 🗑️  جاري تنظيف جميع المكونات...
    echo تنظيف التحديثات القديمة: [██████████] 100%%
    echo إزالة الملفات المؤقتة: [██████████] 100%%
    echo تنظيف السجلات: [██████████] 100%%
    echo إزالة المكونات المعطلة: [██████████] 100%%
    echo.
    echo ✅ التنظيف مكتمل!
